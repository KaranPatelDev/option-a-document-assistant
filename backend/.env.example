# Postgres connection string. Local dev example (requires a running Postgres):
# postgresql+psycopg://postgres:postgres@localhost:5432/option_a
DATABASE_URL=

# Groq API key (https://console.groq.com/keys) — used via the OpenAI-compatible
# chat completions endpoint. Free tier available.
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
